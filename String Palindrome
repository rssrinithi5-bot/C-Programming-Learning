#include <stdio.h>

int main()
{
    char name[50];
    int length = 0;

    printf("Enter a string: ");
    scanf("%s", name);

    // Find length
    for(int i = 0; name[i] != '\0'; i++)
    {
        length++;
    }

    printf("Original = %s\n", name);

    printf("Reverse = ");

    // Print from last character to first
    for(int i = length - 1; i >= 0; i--)
    {
        printf("%c", name[i]);
    }

    printf("\n");

    return 0;
}
