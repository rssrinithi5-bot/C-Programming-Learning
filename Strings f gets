#include <stdio.h>

int main()
{
    char str[100];
    int characters = 0;
    int vowels = 0;

    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    for(int i = 0; str[i] != '\0'; i++)
    {
        if(str[i] != '\n')
        {
            characters++;
        }

        if(str[i] == 'a' || str[i] == 'e' ||
           str[i] == 'i' || str[i] == 'o' ||
           str[i] == 'u' ||
           str[i] == 'A' || str[i] == 'E' ||
           str[i] == 'I' || str[i] == 'O' ||
           str[i] == 'U')
        {
            vowels++;
        }
    }

    printf("\nString = %s", str);
    printf("Characters = %d\n", characters);
    printf("Vowels = %d\n", vowels);

    return 0;
}
